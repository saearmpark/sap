<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.codestudio</groupId>
    <artifactId>db-demo</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>codestudio-db-demo</name>
    <description>STEP 4: JDBC로 backend-java의 H2 데이터베이스에 직접 접속하는 콘솔 예제</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- backend-java(Spring Boot)와 똑같은 H2 드라이버. 프레임워크 없이 JDBC만 직접 씁니다. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.codestudio.dbdemo.DbDemo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
