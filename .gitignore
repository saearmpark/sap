# Git 추적에서 제외할 폴더/파일

# 빌드 결과와 실행 중 생성되는 파일
**/target/
**/uploads/
**/__pycache__/
*.py[cod]

# 데스크톱 도구 빌드 산출물
tools/desktop/build/
tools/desktop/dist/
tools/desktop/*.spec

# 로컬 개발용 DB 파일은 소스 저장소에 포함하지 않습니다.
**/*.db
*.mv.db
*.lock.db
backend-java/backups/

# 실행 중 생성되는 로컬 H2 DB 폴더
/data/
backend-java/data/

# IDE/도구가 만드는 로컬 설정과 잔여물
/backend-java/.vscode/
.github/modernize/
backend-java/.github/modernize/
